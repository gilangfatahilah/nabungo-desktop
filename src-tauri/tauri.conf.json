{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nabungo",
  "version": "0.4.0",
  "identifier": "app.nabungo.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @nabungo/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @nabungo/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nabungo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "publisher": "Nabungo",
    "category": "Finance",
    "shortDescription": "Keuangan pribadi offline",
    "longDescription": "Catat transaksi, saldo, budget, dan alokasi modal. Semua data tersimpan di satu file milik Anda, tanpa internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libssl3"
        ]
      },
      "rpm": {
        "depends": [
          "openssl-libs"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Indonesian",
          "English"
        ]
      }
    }
  }
}
